# --- Обязательный минимум ---
VT_BOT_TOKEN=123456:ABC-DEF...
# Токен бота от @BotFather.

# --- Подписка 200 руб/мес ---
VT_PRICE_RUB=200
VT_CURRENCY=RUB
# Аккаунты paid-programme (без подписки). Через запятую, БЕЗ кавычек.
VT_WHITELIST=835648334,8542930176
# Длительность подписки после оплаты, дней:
VT_DURATION_DAYS=30

# Платёжный провайдер (Telegram Bot Payments): выдаётся в @BotFather -> Payments.
# Пока токен не задан — работает демо-режим: оплата переводом на карту ниже.
VT_PROVIDER_TOKEN=
# Карта для переводов (демо-режим, когда провайдер не настроен):
VT_PAY_CARD=2202 2061 6956 5376

# Принудительно отключить платный шлюз, даже если токен задан:
#VT_DISABLE_PAYMENTS=0

# --- Перевод ---
VT_WHISPER_MODEL=base        # tiny/base/small/medium/large-v3 (чем больше — тем лучше и медленнее)
VT_DEVICE=auto               # auto/cpu/cuda
VT_COMPUTE=auto              # auto/int8/float16
VT_TTS_VOICE=ru-RU-DmitryNeural
VT_MAX_DURATION_MS=3000000   # 50 мин
VT_MAX_SIZE_MB=700
VT_OUT_CODEC=aac
VT_OUT_BITRATE=128k
# Использовать официальный DeepL (лучшее качество), если задан ключ:
VT_DEEPL_KEY=

# --- Запуск ---
VT_POLLING=1                 # 1 = long-polling (простой), 0 = webhook
# Для webhook (если VT_POLLING=0):
#VT_WEBHOOK_URL=https://your.domain/webhook
#VT_WEBHOOK_SECRET=change-me
#VT_PORT=8443

# Рабочая папка (скачанные видео, результаты):
#VT_WORKDIR=./work